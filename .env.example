# Firebase Cloud Messaging (FCM) — optional push notifications.
#
# Leave VITE_FIREBASE_API_KEY blank to disable the entire notification
# feature. When the key is missing, the UI hides itself and every
# notification service short-circuits to a no-op. The app keeps working
# exactly as it does today — no Firebase, no push, no network calls.
#
# To enable:
#   1. Create a Firebase project at https://console.firebase.google.com
#   2. Register this web app (any name, localhost + your domain)
#   3. Copy the apiKey from the Firebase Console "Web API Key" into
#      this file and the matching fields below.
#   4. Rebuild (npm run build) and reinstall the PWA.

VITE_FIREBASE_API_KEY=

# Firebase project config — required for the SDK to initialise.
# These come from the same Firebase Console screen as the API key.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=